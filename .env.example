# Copy to .env (or set these in your hosting dashboard). All are optional for local testing.

PORT=3000
# Public address of the app — used in QR codes. Required in production.
BASE_URL=https://app.steubenvilleconferences.com
NODE_ENV=production
# Where the SQLite database file lives. Put it on a persistent disk in production.
DB_PATH=/data/app.db
# Set to 1 when running behind a load balancer / proxy (most hosts).
TRUST_PROXY=1

# Long random string used to sign logins. Generated automatically if unset.
SESSION_SECRET=
# Web Push keys. Generated automatically and stored in the database if unset.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can reach if there is a problem.
VAPID_SUBJECT=mailto:webteam@example.com
